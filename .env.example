# ── Shree Milk Bank Dairy — environment configuration ──
# Copy to .env and fill in real values. NEVER commit the real .env.

# development | production
FLASK_ENV=production

# REQUIRED in production — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret

# Database URL.
# SQLite (dev only):  sqlite:///smart_dairy.db
# PostgreSQL (prod):  postgresql+psycopg2://user:password@host:5432/dairy
DATABASE_URL=postgresql+psycopg2://dairy_user:CHANGE_ME@127.0.0.1:5432/dairy

# Comma-separated allowed CORS origins. Leave empty for same-origin only.
CORS_ORIGINS=

# '1' to mark the auth cookie Secure (send only over HTTPS).
SESSION_COOKIE_SECURE=1

# Server binding (run.py / production.py)
HOST=0.0.0.0
PORT=8000

# Login rate limiting (per IP)
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW=300

# Email delivery (SMTP) — used for password reset OTPs and notifications.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@example.com
SMTP_PASSWORD=CHANGE_ME
MAIL_FROM=Shree Milk Bank Dairy <notifications@example.com>

# Development-only: admin/admin123 bypass and OTP echo. Leave 0 in production.
DEV_LOGIN_ENABLED=0
